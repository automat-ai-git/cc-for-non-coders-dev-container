# Password for the auth gateway (single login for IDE + File Browser)
PASSWORD=student-2026

# Z.AI API — primary key
# Get yours at https://open.bigmodel.cn/
GLM_API_KEY=your-zai-api-key-here

# Model mapping (defaults: GLM-5.3 for Opus and Sonnet, GLM-4.5-Air for Haiku).
# z.ai remaps on the fly: GLM-5.2 and GLM-5.1 are also served by glm-5.3, and
# GLM-4.5-Air by glm-4.7 (Air itself is retired).
# Uncomment to override:
# GLM_OPUS_MODEL=GLM-5.3
# GLM_SONNET_MODEL=GLM-5.3
# GLM_HAIKU_MODEL=GLM-4.5-Air

# API request timeout (ms)
# API_TIMEOUT_MS=3000000

# Backup key (optional — fallback if primary key hits rate limits)
GLM_API_KEY_BACKUP=
