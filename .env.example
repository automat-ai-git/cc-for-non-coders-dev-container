# Пароль для входа в рабочую среду (IDE + файловый менеджер)
PASSWORD=ваш-пароль

# API-ключ Z.AI — основной
GLM_API_KEY=ваш-ключ-от-z-ai

# API-ключ Z.AI — резервный (опционально, для переключения при лимитах)
GLM_API_KEY_BACKUP=

# Маппинг моделей (опционально, ниже указаны значения по умолчанию)
# GLM_OPUS_MODEL=GLM-5.1
# GLM_SONNET_MODEL=GLM-5.1
# GLM_HAIKU_MODEL=GLM-4.5-Air

# Таймаут запросов в миллисекундах (опционально)
# API_TIMEOUT_MS=3000000

# Роутер моделей (опционально)
# Если запущен LiteLLM — укажите его адрес, иначе запросы идут напрямую в Z.AI
# ANTHROPIC_BASE_URL=http://litellm:4000
