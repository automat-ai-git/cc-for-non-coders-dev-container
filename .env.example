# =============================================================================
# Пароль для входа в рабочую среду (IDE + File Browser)
# =============================================================================
PASSWORD=main_password

# =============================================================================
# Режимы работы (переключаются ВНУТРИ контейнера, без пересборки):
#   ~/switch-model.sh subscription   — Claude по подписке (api.anthropic.com)
#   ~/switch-model.sh glm            — GLM (Z.AI) напрямую            ← по умолчанию
#   ~/switch-model.sh ollama <модель> — Ollama напрямую
#   ~/switch-model.sh lmstudio [модель] — LM Studio напрямую
# Все режимы подключаются напрямую, без прокси.
# =============================================================================

# =============================================================================
# Z.AI — провайдер по умолчанию (GLM-модели). Ключи: https://open.bigmodel.cn/
# =============================================================================
GLM_API_KEY=main_key
GLM_API_KEY_BACKUP=

# Модели Z.AI (раскомментируй чтобы переопределить дефолты образа)
GLM_OPUS_MODEL=GLM-5.3
GLM_SONNET_MODEL=GLM-5.2
GLM_HAIKU_MODEL=GLM-4.7

# =============================================================================
# Локальная модель Ollama (режим ~/switch-model.sh ollama)
# =============================================================================
OLLAMA_MODEL=your-ollama-model:latest

# =============================================================================
# Anthropic — реальный Claude (режим ~/switch-model.sh subscription)
# Логин делается внутри контейнера: claude login. Ключ здесь не обязателен.
# =============================================================================
# ANTHROPIC_API_KEY=sk-ant-...

# =============================================================================
# Таймаут API-запросов (мс). 3000000 = 50 минут
# =============================================================================
API_TIMEOUT_MS=3000000

# =============================================================================
# SearXNG MCP — веб-поиск для локальных моделей (опционально)
# =============================================================================
SEARXNG_URL=https://your-searxng-instance.com

# =============================================================================
# Plane MCP — интеграция с Plane (опционально)
# =============================================================================
PLANE_API_KEY=plane_api_
PLANE_WORKSPACE_SLUG=slug
PLANE_BASE_URL=http://your-plane-host:8000

# =============================================================================
# LM Studio — endpoint машины с GPU (режим ~/switch-model.sh lmstudio)
# У каждого сервера своё значение. Не коммитить реальный адрес!
# =============================================================================
LMSTUDIO_URL=http://your-lmstudio-host:8080

# =============================================================================
# Пути на хосте (host-specific, у каждого сервера своё)
# HOST_HOME     — домашняя директория пользователя на хосте (для volume-монтирования).
#                 Задаётся явно, чтобы ${HOME} не разрешался в HOME агента внутри контейнера.
#                 Репозиторий должен быть склонирован в ${HOST_HOME}/cc-for-non-coders-dev-container:
#                 к этому абсолютному пути привязаны student-data и claude-config в docker-compose.yml.
#                 Абсолютные пути (а не относительные ./) не дают docker создавать фантомные
#                 пустые папки при пересоздании контейнера из чужого cwd (через агента-мост).
# MEETING_DATA_DIR — каталог с данными митингов (монтируется в /meeting-data:ro).
#                 Если не задан — дефолт ${HOST_HOME}/cc-for-non-coders-dev-container/meeting-data.
# =============================================================================
HOST_HOME=/home/your-user
MEETING_DATA_DIR=/path/to/meeting-data
