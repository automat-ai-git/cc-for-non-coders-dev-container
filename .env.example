# =============================================================================
# Пароль для входа в рабочую среду (IDE + File Browser)
# =============================================================================
PASSWORD=student-2026

# =============================================================================
# Z.AI — провайдер по умолчанию (GLM-модели)
# Ключи: https://open.bigmodel.cn/
# =============================================================================
GLM_API_KEY=your-zai-api-key-here
GLM_API_KEY_BACKUP=

# Модели Z.AI (раскомментируй чтобы переопределить)
# Lite-план: GLM-4.7, GLM-4.6, GLM-4.5, GLM-4.5-Air
# Pro/Max:   + GLM-5, GLM-5-Turbo
# GLM_OPUS_MODEL=GLM-4.7
GLM_SONNET_MODEL=GLM-4.7
# GLM_HAIKU_MODEL=GLM-4.5-Air

# =============================================================================
# Anthropic — реальный Claude (для переключения через switch-api-key.sh claude)
# Ключи: https://console.anthropic.com/
# Модели: claude-opus-4-6 | claude-sonnet-4-6 | claude-haiku-4-5-20251001
# =============================================================================
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_OPUS_MODEL=claude-opus-4-6
# ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6
# ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001

# =============================================================================
# Таймаут API-запросов (мс). 3000000 = 50 минут
# =============================================================================
# API_TIMEOUT_MS=3000000

# =============================================================================
# Plane MCP — интеграция с Plane (опционально)
# =============================================================================
# PLANE_API_KEY=your-plane-api-key-here
# PLANE_WORKSPACE_SLUG=your-workspace-slug
# PLANE_BASE_URL=http://your-plane-api:8000