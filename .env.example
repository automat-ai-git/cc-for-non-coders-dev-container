# =============================================================================
# Пароль для входа в рабочую среду (IDE + File Browser)
# =============================================================================
PASSWORD=main_password

# =============================================================================
# Режим по умолчанию при старте контейнера: litellm
# Переключение внутри контейнера (на ходу, без пересборки):
#   ~/switch-model.sh subscription   — Claude по подписке
#   ~/switch-model.sh litellm        — LiteLLM-роутер (GLM, Ollama, ...)
# =============================================================================

# =============================================================================
# LiteLLM-режим — ключ и endpoint для роутера
# Роутер сам решает куда направить: GLM, Ollama, OpenAI, ...
# Настройка моделей — в litellm_config.yaml на стороне LiteLLM
# =============================================================================
GLM_API_KEY=main_key
GLM_API_KEY_BACKUP=

# Модели (используются в LiteLLM-режиме)
GLM_OPUS_MODEL=GLM-5.2
GLM_SONNET_MODEL=GLM-5.1
GLM_HAIKU_MODEL=GLM-4.7

# =============================================================================
# Таймаут API-запросов (мс). 3000000 = 50 минут
# =============================================================================
API_TIMEOUT_MS=3000000

# =============================================================================
# SearXNG MCP — веб-поиск (опционально)
# =============================================================================
SEARXNG_URL=https://your-searxng-instance.com

# =============================================================================
# Plane MCP — интеграция с Plane (опционально)
# =============================================================================
PLANE_API_KEY=plane_api_
PLANE_WORKSPACE_SLUG=slug
PLANE_BASE_URL=http://plane-app-api-1:8000
